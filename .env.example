GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Protect the API in live deployments. Leave blank for local demo mode.
RESEARCH_MANAGER_API_KEY=
RESEARCH_MANAGER_REQUIRE_AUTH=false
# Optional SQLAlchemy URL, e.g. postgresql+psycopg://user:password@host/dbname
RESEARCH_MANAGER_DATABASE_URL=
# Neon CLI writes DATABASE_URL to .env; the backend accepts it automatically.

# Optional MLflow tracking. Leave blank to run without MLflow.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ResearchManager